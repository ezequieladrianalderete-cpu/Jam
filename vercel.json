{
  "version": 2,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" },
    { "src": "*.ico", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/musica", "dest": "/musica.html" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*\\.(png|ico|html))", "dest": "/$1" },
    { "src": "/", "dest": "/index.html" }
  ]
}
