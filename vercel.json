{
  "version": 2,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.pdf", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" },
    { "src": "*.ico", "use": "@vercel/static" },
    { "src": "docs/**", "use": "@vercel/static" },
    { "src": "imgs/**", "use": "@vercel/static" },
    {
      "src": "api/*.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["imgs/**", "fonts/**"] }
    }
  ],
  "rewrites": [
    { "source": "/musica", "destination": "/musica.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/check", "destination": "/check.html" },
    { "source": "/evento", "destination": "/evento.html" },
    { "source": "/competencia", "destination": "/competencia.html" },
    { "source": "/api/notify", "destination": "/api/notify.js" },
    { "source": "/api/enviar-devolucion", "destination": "/api/enviar-devolucion.js" },
    { "source": "/api/health", "destination": "/api/health.js" },
    { "source": "/api/reenviar-qr", "destination": "/api/reenviar-qr.js" },
    { "source": "/api/enviar-credenciales-masivo", "destination": "/api/enviar-credenciales-masivo.js" },
    { "source": "/api/enviar-devoluciones-pendientes", "destination": "/api/enviar-devoluciones-pendientes.js" }
  ]
}
